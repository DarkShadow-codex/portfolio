# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Duplicate this file as '.env' for local sensitive parameters.
# The '.env' file is ignored by .gitignore and will NEVER be pushed to GitHub.
# ==============================================================================

# Primary Contact Email Endpoint
PORTFOLIO_CONTACT_EMAIL=your-email@domain.com
FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/your-email@domain.com

# Direct Channels
SIGNAL_ENDPOINT=@your-signal-handle

# OpenPGP / Kleopatra Public Specification
PGP_FINGERPRINT=XXXX XXXX XXXX XXXX XXXX  XXXX XXXX XXXX XXXX XXXX
PGP_KEY_ID=0xXXXXXXXX
